# ============================================================================
# EntraGuard — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#   nano .env
# ============================================================================

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=cspm
POSTGRES_USER=cspm_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# ── App secret ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32

# ── Azure / Entra ID credentials ────────────────────────────────────────────
# From your App Registration in Entra ID → App registrations
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Display ─────────────────────────────────────────────────────────────────
TARGET_NAME=My Azure Tenant
INSTANCE_NAME=EntraGuard

# ── Ports ───────────────────────────────────────────────────────────────────
PORT=3000

# ── Authentication ──────────────────────────────────────────────────────────
# Set to true to require login. false = anyone with network access gets in —
# this now genuinely gates the data API, not just the login page.
AUTH_ENABLED=false

# Local admin fallback (used when AUTH_ENABLED=true)
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=

# With AUTH_ENABLED=true the API refuses to start unless SECRET_KEY above is a
# real random value (>= 32 chars, not the CHANGE_ME placeholder).

# Microsoft sign-in: comma-separated UPNs that get the admin role. Everyone
# else who signs in with Microsoft starts as a viewer and can be promoted
# from the Users page.
MSAL_ADMIN_USERS=

JWT_EXPIRE_HOURS=8

# Base URL this app is reachable at — used to build the MSAL redirect URI
# AND to lock down CORS (only this origin may make credentialed API calls).
# Must match exactly what you register in Azure Portal → App registration →
# Authentication → Redirect URIs (as {APP_BASE_URL}/api/v1/auth/callback).
# MSAL requires HTTPS for any non-localhost URL.
APP_BASE_URL=http://localhost:3000

# Comma-separated additional allowed CORS origins, e.g. for local dev on a
# different port. Leave blank in production — APP_BASE_URL alone is correct.
CORS_EXTRA_ORIGINS=

# Login endpoint rate limiting — protects /auth/login and /auth/login/extended
# from brute-force. Per-IP, in-memory (resets on container restart).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ── Telemetry ───────────────────────────────────────────────────────────────
TELEMETRY_ENABLED=false

# ── AI Explanation Layer (optional, OFF by default) ──────────────────────────
# For a capped, priority-selected subset of findings each scan, this adds:
#   1. A plain-English explanation of WHY the check passed or failed
#   2. A false-positive likelihood flag (none/possible/likely) — the AI's
#      judgment on whether the deterministic verdict might be wrong due to
#      tenant context the check's Graph query couldn't see (e.g. "this CA
#      check failed, but MFA might actually be enforced tenant-wide via
#      Security Defaults, which this specific check doesn't query")
#   3. One AI-written narrative summary per completed scan, covering overall
#      posture and what to prioritise
#
# HARD BOUNDARY: none of this ever changes a finding's status, score, or
# severity — the false-positive flag is a visible caution to the reviewer,
# not an override. See ai_explainer.py's module docstring for full detail.
#
# Enabling this sends evidence (policy names, scenario labels, licence
# booleans — no raw tenant secrets) to whichever provider you configure below.
AI_EXPLAIN_ENABLED=false

# "anthropic", "openai", "groq", or "ollama"
AI_EXPLAIN_PROVIDER=anthropic

# ALL checks are eligible for explanation — there is no allowlist by check ID
# anymore. This caps how many findings get explained PER SCAN to control
# cost/latency (each explained finding is one AI call). Selection order when
# the cap is hit:
#   1. Conditional Access checks (AZURE-CA-*, AZURE-RISK-*) — always first
#   2. Remaining FAILED findings, by severity then score, descending
#   3. PASSED findings, only if budget remains after all failures are covered
AI_EXPLAIN_MAX_PER_SCAN=30

# ── Investigative Agent (optional, OFF by default, separate from the above) ───
# A more powerful mode: instead of narrating a pre-packaged evidence summary,
# the AI can call a bounded, read-only Microsoft Graph query tool to actually
# verify a finding — e.g. checking whether Security Defaults independently
# covers an MFA gap the check itself didn't query. Every query the agent
# makes is logged and stored (see ai_queries_made on each finding) so you can
# audit exactly what it looked at.
#
# HEAVIER than the base explainer: each investigated finding costs up to
# AI_AGENT_MAX_TOOL_CALLS+1 LLM calls instead of 1, so it runs on a much
# smaller, separately-capped subset of findings per scan.
#
# Requires a model that supports tool/function calling. Groq's free-tier
# default (llama-3.1-8b-instant) does NOT reliably support this — use
# llama-3.3-70b-versatile or better. Currently only wired up for
# OpenAI-compatible providers (Groq, OpenAI, Ollama-with-tools) — Anthropic's
# tool-calling API has a different shape and isn't supported by this yet.
AI_AGENT_ENABLED=false

# Max Graph lookups the agent can make per finding before it must answer
AI_AGENT_MAX_TOOL_CALLS=3

# How many findings per scan get the (expensive) agent treatment, separate
# from and in addition to AI_EXPLAIN_MAX_PER_SCAN above
AI_AGENT_MAX_FINDINGS_PER_SCAN=5

# Model override for the agent specifically — needs tool-calling support.
# The agent uses whichever provider AI_EXPLAIN_PROVIDER is set to; set the
# matching model var below for that provider.
AI_AGENT_MODEL_GROQ=llama-3.3-70b-versatile

# Local Ollama models for the agent. Tool-calling support varies sharply by
# model — qwen2.5 / qwen3 and llama3.1+ generally work; smaller or older
# models often don't emit tool_calls at all, in which case the agent silently
# falls back to the plain explainer. If the agent never seems to run under
# Ollama, try a larger model before assuming it's broken.
#   ollama pull qwen2.5
AI_AGENT_MODEL_OLLAMA=qwen2.5
AI_AGENT_MODEL_OPENAI=gpt-4o-mini

# Wall-clock ceiling for ONE finding's agent investigation. Bounds the whole
# tool-calling loop, not just each individual HTTP call — without this, a
# slow-but-not-timing-out provider could stretch a single investigation past
# a minute, and several sequential investigations then add minutes to a scan.
# Local Ollama on modest hardware is meaningfully slower than a hosted API —
# raise this if you see agent timeouts in the worker logs when using Ollama.
AI_AGENT_MAX_SECONDS_PER_FINDING=90

# Only the key for your chosen provider needs to be set — the others are unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Groq — FREE tier, no payment required. Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Ollama — FREE, fully local, no API key needed, no data leaves your
# infrastructure at all. Requires Ollama installed and running somewhere the
# worker container can reach it:
#   1. Install Ollama on your Docker host: https://ollama.com/download
#   2. Pull a model:  ollama pull llama3.1
#   3. Leave OLLAMA_BASE_URL at its default below — docker-compose.yml
#      already adds the extra_hosts entry needed for host.docker.internal
#      to resolve correctly on Linux.
# If Ollama runs on a different machine, point this at that machine's IP
# instead, e.g. http://192.168.1.50:11434/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# Optional model overrides (sensible defaults are used if left blank)
# AI_EXPLAIN_MODEL_ANTHROPIC=claude-sonnet-4-6
# AI_EXPLAIN_MODEL_OPENAI=gpt-4o-mini
# AI_EXPLAIN_MODEL_GROQ=llama-3.1-8b-instant
# AI_EXPLAIN_MODEL_OLLAMA=llama3.1

# Optional: point at an OpenAI-compatible endpoint (e.g. Azure OpenAI, a
# self-hosted proxy) instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1
